# Copy to .env and fill in. Never commit the real .env.
#   cp .env.example .env

# Google Gemini API key — https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# LangSmith tracing (optional but recommended in production)
# https://smith.langchain.com/settings
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=bookly_agent

# Model used by nodes.py. Must be a model id resolvable by
# langchain.chat_models.init_chat_model (prefix with provider).
LLM_MODEL=google_genai:gemini-2.5-flash
